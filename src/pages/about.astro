---
import { withBase } from '../utils/paths';
import { getEntry } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import '../styles/tribute.css';

const entry = await getEntry('pages', 'about');
if (!entry || entry.data.draft || !entry.data.imageUrl) throw new Error('Published tribute content and image are required.');
const { title, imageUrl, imageAlt, credit } = entry.data;
---
<!doctype html>
<html lang="si">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="බෙල්ලන්විල ධම්මානන්ද හිමියන් පිළිබඳ ප්‍රණාම ලිපිය. Author: Dr. Lasitha Malalasekara." />
    <meta name="theme-color" content="#233e34" />
    <link rel="canonical" href={new URL(withBase('/about/'), Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:title" content={`${title} · Valagamba`} />
    <meta property="og:description" content="A tribute to Venerable Bellanwila Dhammananda Thero, by Dr. Lasitha Malalasekara." />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={new URL(withBase('/about/'), Astro.site).href} />
    <title>{title} · Valagamba</title>
  </head>
  <body>
    <a class="skip-link" href="#main">ප්‍රධාන අන්තර්ගතයට යන්න</a>
    <SiteHeader />
    <main id="main" class="container tribute-main">
      <nav class="tribute-breadcrumbs" aria-label="පිටු මාර්ගය"><a href={withBase('/')}>මුල් පිටුව</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
      <header class="tribute-intro"><p class="eyebrow" lang="en">A tribute</p><h1>{title}<span class="title-dot">.</span></h1>{credit && <p lang="en">{credit}</p>}</header>
      <figure class="tribute-document">
        <a href={withBase(imageUrl)} aria-label="ප්‍රණාම ලිපියේ සම්පූර්ණ රූපය විවෘත කරන්න"><img src={withBase(imageUrl)} alt={imageAlt || title} width="791" height="1024" fetchpriority="high" /></a>
        <figcaption>{credit && <span lang="en">{credit}</span>}<a class="text-link" href={withBase(imageUrl)}>සම්පූර්ණ රූපය විවෘත කරන්න <span aria-hidden="true">↗</span></a></figcaption>
      </figure>
      <a class="text-link" href={withBase('/')}><span aria-hidden="true">←</span> මුල් පිටුව</a>
    </main>
    <SiteFooter />
  </body>
</html>
