---
import categories from '../data/categories.json';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

const originalSite = 'https://valagamba.net';
---

<!doctype html>
<html lang="si">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="වලගම්බා ආරණ්‍යවාසී අති පූජ්‍ය බෙල්ලන්විල ධම්මානන්ද ස්වාමින්වහන්සේගේ ධර්ම දේශනා එකතුව. Vipassana, mindfulness, Abhidhamma teachings and books." />
    <meta name="theme-color" content="#233e34" />
    <link rel="canonical" href="https://valagamba.net/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="වලගම්බා ආරණ්‍ය දේශනා · Valagamba" />
    <meta property="og:description" content="Lord Buddha’s Teachings, by Venerable Bellanwila Dhammananda Thero." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://valagamba.net/" />
    <title>වලගම්බා ආරණ්‍ය දේශනා · Valagamba</title>
  </head>
  <body>
    <a class="skip-link" href="#main">ප්‍රධාන අන්තර්ගතයට යන්න</a>
    <SiteHeader />

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow" lang="en">A space for listening & reflection</p>
            <h1 id="hero-title">වලගම්බා<br />ආරණ්‍ය දේශනා<span class="title-dot">.</span></h1>
            <p class="hero-description">එරියාව වලගම්බා ආරණ්‍යවාසී, අති පූජ්‍ය බෙල්ලන්විල ධම්මානන්ද ස්වාමින්වහන්සේ විසින් කරන ලද ධර්ම දේශනා එකතුවකි.</p>
            <p class="hero-english" lang="en">Lord Buddha’s Teachings,<br />by Venerable Bellanwila Dhammananda Thero.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#teachings">දේශනා වෙත පිවිසෙන්න <span aria-hidden="true">↗</span></a>
              <a class="text-link" href="/basic-vipassana/">මුලික විපස්සනා ක්‍රම <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <figure class="hero-art">
            <div class="image-frame">
              <img src="https://valagamba.net/wp-content/uploads/2020/03/buddha-bg-1.jpg" alt="බුද්ධ ප්‍රතිමාව" fetchpriority="high" width="700" height="800" />
            </div>
            <figcaption><span class="caption-line" aria-hidden="true"></span><span lang="en">THE TEACHINGS OF THE BUDDHA</span></figcaption>
            <span class="art-ring" aria-hidden="true"></span>
          </figure>
        </div>
      </section>

      <section class="library section-padding" id="teachings" aria-labelledby="teachings-title">
        <div class="container">
          <div class="section-heading">
            <div><p class="eyebrow" lang="en">Explore the collection</p><h2 id="teachings-title">ධර්ම දේශනා</h2></div>
            <p class="section-intro">විපස්සනා, සතිය සහ අභිධර්මය පිළිබඳ<br class="desktop-break" /> දේශනා විෂය අනුව තෝරාගන්න.</p>
          </div>
          <div class="library-tools" hidden>
            <div class="filters" role="group" aria-label="දේශනා වර්ගය">
              <button type="button" data-filter="all" aria-pressed="true">සියල්ල</button>
              <button type="button" data-filter="meditation" aria-pressed="false">භාවනා</button>
              <button type="button" data-filter="study" aria-pressed="false">දහම් අධ්‍යයනය</button>
            </div>
            <label class="search-box"><span aria-hidden="true">⌕</span><span class="sr-only">දේශනා වර්ග සොයන්න</span><input id="category-search" type="search" placeholder="දේශනා වර්ග සොයන්න…" autocomplete="off" /></label>
          </div>
          <div class="category-grid">
            {categories.map((category, index) => (
              <a class="category-card" href={category.local ? category.path : `${originalSite}${category.path}`} data-group={category.group} data-search={`${category.title} ${category.english}`}>
                <span class="card-top"><span class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="card-arrow" aria-hidden="true">↗</span></span>
                <h3>{category.title}</h3>
                <p lang="en">{category.english}</p>
              </a>
            ))}
          </div>
          <p class="empty-state" hidden>ගැළපෙන දේශනා වර්ග හමු නොවීය. වෙනත් වචනයක් භාවිත කරන්න.</p>
          <p class="sr-only" id="search-status" role="status" aria-live="polite"></p>
        </div>
      </section>

      <section class="resources" id="books" aria-labelledby="books-title">
        <div class="container resources-inner">
          <div class="book-illustration" aria-hidden="true"><span>වලගම්බා</span><span class="book-wheel">☸</span><span>විදර්ශනා කෘති</span></div>
          <div class="resource-copy"><p class="eyebrow" lang="en">Read & reflect</p><h2 id="books-title">විශේෂ විදර්ශනා කෘති</h2><p>විදර්ශනා අධ්‍යයනය සඳහා කෘති එකතුව වෙත පිවිසෙන්න.</p><a class="button button-light" href="/books/">කෘති එකතුව <span aria-hidden="true">↗</span></a></div>
          <span class="resource-decoration" aria-hidden="true">☸</span>
        </div>
      </section>

      <section class="about section-padding" id="about" aria-labelledby="about-title">
        <div class="container about-grid">
          <div><p class="eyebrow" lang="en">About this collection</p><h2 id="about-title">දේශනා එකතුව පිළිබඳව</h2></div>
          <div><p class="about-lead">අති පූජ්‍ය බෙල්ලන්විල ධම්මානන්ද ස්වාමින්වහන්සේගේ ධර්ම දේශනා, විදර්ශනා අධ්‍යයනය සඳහා මෙසේ එක්තැන් කර ඇත.</p><p lang="en">A collection of Dhamma teachings by Venerable Bellanwila Dhammananda Thero of Eriyawa Valagamba Aranya.</p><a class="text-link" href="/about/">ප්‍රණාමය <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>
    </main>

    <SiteFooter />
    <script>
      const tools = document.querySelector<HTMLElement>('.library-tools');
      const search = document.querySelector<HTMLInputElement>('#category-search');
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const cards = document.querySelectorAll<HTMLAnchorElement>('.category-card');
      const empty = document.querySelector<HTMLElement>('.empty-state');
      const status = document.querySelector<HTMLElement>('#search-status');
      let filter = 'all';
      const normalize = (text: string) => text.normalize('NFC').toLocaleLowerCase().trim();
      function update() {
        const query = normalize(search?.value ?? '');
        let count = 0;
        cards.forEach((card) => {
          const matches = (filter === 'all' || card.dataset.group === filter) && normalize(card.dataset.search ?? '').includes(query);
          card.hidden = !matches;
          if (matches) count++;
        });
        if (empty) empty.hidden = count !== 0;
        if (status) status.textContent = `දේශනා වර්ග ${count}`;
      }
      buttons.forEach((button) => button.addEventListener('click', () => {
        filter = button.dataset.filter ?? 'all';
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        update();
      }));
      search?.addEventListener('input', update);
      if (tools) tools.hidden = false;
    </script>
  </body>
</html>
