---
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import YouTubePlayer from '../components/YouTubePlayer.astro';
import TeachingContents from '../components/TeachingContents.astro';
import '../styles/global.css';
import '../styles/teachings.css';

interface Props {
  series: string;
  title: string;
  englishTitle: string;
  description: string;
  referenceImage?: string;
  referenceTitle?: string;
  groups?: { id: string; title: string }[];
  scrollContents?: boolean;
}
const { series, title, englishTitle, description, referenceImage, referenceTitle, groups, scrollContents = false } = Astro.props;
const canonical = `https://valagamba.net/${series}/`;
const teachings = (await getCollection('teachings', ({ data }) => data.series === series && !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
if (groups && teachings.some(({ data }) => !groups.some((group) => group.id === data.lessonGroup))) {
  throw new Error(`Every teaching in ${series} must belong to a configured lesson group.`);
}
const sections = groups
  ? groups.map((group) => ({ ...group, teachings: teachings
      .filter(({ data }) => data.lessonGroup === group.id)
      .sort((a, b) => (a.data.groupOrder ?? a.data.order) - (b.data.groupOrder ?? b.data.order)) }))
  : [{ id: 'all-teachings', title: '', teachings }];
---

<!doctype html>
<html lang="si">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#233e34" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} · Valagamba`} />
    <meta property="og:description" content={`${englishTitle} — teachings by Venerable Bellanwila Dhammananda Thero.`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title} · Valagamba</title>
  </head>
  <body>
    <a class="skip-link" href="#main">ප්‍රධාන අන්තර්ගතයට යන්න</a>
    <SiteHeader />
    <main id="main">
      <section class="collection-intro container">
        <nav class="breadcrumbs" aria-label="පිටු මාර්ගය"><a href="/">මුල් පිටුව</a><span aria-hidden="true">/</span><a href="/#teachings">දේශනා</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
        <p class="eyebrow" lang="en">{englishTitle}</p>
        <h1>{title}<span class="title-dot">.</span></h1>
        <p class="collection-description">{description}</p>
        <div class="collection-meta"><span>දේශනා {teachings.length}</span><span aria-hidden="true">·</span><span>සිංහල</span></div>
      </section>

      <div class="container collection-layout">
        <aside class="collection-sidebar" aria-labelledby="contents-title">
          <h2 id="contents-title">දේශනා අනුපිළිවෙළ</h2>
          {sections.map((section) => {
            const Group = section.title ? 'details' : 'div';
            return <Group class="contents-group" open={section.title ? true : undefined}>
            {section.title && <summary class="contents-group-toggle">{section.title}</summary>}
            <TeachingContents teachings={section.teachings} scroll={!!section.title || scrollContents} label={section.title || (scrollContents ? title : undefined)} />
          </Group>;})}
          {referenceImage && <a class="text-link" href="#reference">{referenceTitle} <span aria-hidden="true">↓</span></a>}
        </aside>

        <div class="collection-main">
          {sections.map((section) => {
            const Group = section.title ? 'details' : 'div';
            return <section class="teaching-list" id={section.id} aria-label={section.title || 'දේශනා එකතුව'}>
            <Group class="lesson-group" open={section.title ? true : undefined}>
            {section.title && <summary class="lesson-group-heading"><span><span class="lesson-group-title" role="heading" aria-level="2">{section.title}</span><span class="lesson-group-count">දේශනා {section.teachings.length}</span></span></summary>}
            <div class:list={[{ 'lesson-group-scroll': !!section.title }]} tabindex={section.title ? 0 : undefined} role={section.title ? 'region' : undefined} aria-label={section.title || undefined}>
            {section.teachings.map(({ data }, index) => (
              <article class="teaching-entry" id={`teaching-${data.order}`}>
                <div class="teaching-heading"><span class="teaching-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{section.title ? <h3>{data.title}</h3> : <h2>{data.title}</h2>}</div>
                {data.youtubeId && <YouTubePlayer id={data.youtubeId} title={data.title} />}
                {data.videoUrl && <div class="native-video-player"><video controls playsinline preload="none" aria-label={data.title} src={data.videoUrl}><a href={data.videoUrl}>වීඩියෝව නරඹන්න</a></video><a class="text-link" href={data.videoUrl}>වීඩියෝ ගොනුව විවෘත කරන්න <span aria-hidden="true">↗</span></a></div>}
                {data.audioUrl && <div>{data.videoUrl && <p class="audio-alternative">ශ්‍රව්‍ය පමණක් අසන්න</p>}<audio controls preload="none" aria-label={data.title} src={data.audioUrl}><a href={data.audioUrl}>දේශනාව අසන්න</a></audio><a class="text-link" href={data.audioUrl}>ශ්‍රව්‍ය ගොනුව විවෘත කරන්න <span aria-hidden="true">↗</span></a></div>}
                {!data.youtubeId && !data.videoUrl && !data.audioUrl && <a class="text-link original-recording" href={data.originalUrl}>මුල් පිටුවෙන් දේශනාව අසන්න <span aria-hidden="true">↗</span></a>}
              </article>
            ))}
          </div>
          </Group>
          </section>;})}
          {referenceImage && <section class="reference-panel" id="reference" aria-labelledby="reference-title">
            <div><p class="eyebrow" lang="en">Reference</p><h2 id="reference-title">{referenceTitle}</h2><a class="text-link" href={referenceImage}>රූපය විවෘත කරන්න <span aria-hidden="true">↗</span></a></div>
            <a href={referenceImage} aria-label={`${referenceTitle} — රූපය විවෘත කරන්න`}><img src={referenceImage} alt={referenceTitle} loading="lazy" /></a>
          </section>}
          <a class="text-link back-link" href="/#teachings"><span aria-hidden="true">←</span> සියලුම දේශනා වර්ග</a>
        </div>
      </div>
    </main>
    <SiteFooter />
    <script>
      // Open a collapsed group before following a lesson's stable anchor.
      function revealLesson(hash: string, scroll = false) {
        const target = document.getElementById(hash.slice(1));
        if (!target) return;
        let parent: HTMLElement | null = target;
        while (parent) {
          if (parent instanceof HTMLDetailsElement) parent.open = true;
          parent = parent.parentElement;
        }
        target.querySelectorAll<HTMLDetailsElement>(':scope > details').forEach((group) => group.open = true);
        if (scroll) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
      }
      document.querySelectorAll<HTMLAnchorElement>('.collection-sidebar a[href^="#"]').forEach((link) => {
        link.addEventListener('click', () => revealLesson(link.hash));
      });
      window.addEventListener('hashchange', () => revealLesson(location.hash, true));
      if (location.hash) revealLesson(location.hash, true);

      // Keep simultaneous recordings from competing for sound.
      document.querySelectorAll<HTMLMediaElement>('audio, video').forEach((media) => {
        media.addEventListener('play', () => {
          document.querySelectorAll<HTMLMediaElement>('audio, video').forEach((other) => {
            if (other !== media) other.pause();
          });
        });
      });
    </script>
  </body>
</html>
